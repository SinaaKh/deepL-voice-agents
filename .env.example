# VoiceLab configuration. Copy to `.env` (git-ignored) and fill in what you have.
# Everything is OPTIONAL: with no keys at all, the local stack (Silero VAD + Whisper + Ollama + Piper)
# and the simulated providers still work.

# ---- Cloud providers (each unlocks more options in the dashboard) ---------------------------
OPENAI_API_KEY=            # STT (gpt-4o-mini-transcribe), LLM (gpt-4o / mini), TTS, Realtime speech-to-speech
ANTHROPIC_API_KEY=         # Anthropic models as the LLM
ELEVEN_API_KEY=            # ElevenLabs TTS (voice_id swapping, custom voice clones)
DEEPGRAM_API_KEY=          # streaming STT
GROQ_API_KEY=              # ultra-fast Llama inference
CEREBRAS_API_KEY=
TOGETHER_API_KEY=

# ---- Local models --------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
WHISPER_MODEL=base.en      # tiny.en is ~2x faster, small.en is more accurate

# ---- LiveKit (the "LiveKit" page and livekit_agent/agent.py) -------------------------------
# Local dev server:  livekit-server --dev   (key "devkey", secret "secret")
# LiveKit Cloud:     copy the URL / key / secret from your project settings
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---- LiveKit agent knobs (see livekit_agent/agent.py) --------------------------------------
# LK_STT=openai            # openai | deepgram
# LK_LLM=openai            # openai | groq | cerebras | together | ollama
# LK_LLM_MODEL=gpt-4o-mini # try gpt-4o to reproduce the Lesson 5 TTFT comparison
# LK_TTS=elevenlabs        # elevenlabs | openai
# LK_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
# LK_TURN=semantic         # semantic | vad
# LK_MIN_ENDPOINTING_DELAY=0.5
# LK_MAX_ENDPOINTING_DELAY=3.0
